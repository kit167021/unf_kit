<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидДвиженияПроизводство</dataPath>
			<field>ВидДвиженияПроизводство</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХарактеристикаНоменклатуры</dataPath>
			<field>ХарактеристикаНоменклатуры</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Пакет_Штабель</dataPath>
			<field>Пакет_Штабель</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоШтКонечныйОстаток</dataPath>
			<field>КоличествоШтКонечныйОстаток</field>
			<role>
				<dcscom:balance>true</dcscom:balance>
				<dcscom:balanceGroupName>КоличествоШт</dcscom:balanceGroupName>
				<dcscom:balanceType>ClosingBalance</dcscom:balanceType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоШтНачальныйОстаток</dataPath>
			<field>КоличествоШтНачальныйОстаток</field>
			<role>
				<dcscom:balance>true</dcscom:balance>
				<dcscom:balanceGroupName>КоличествоШт</dcscom:balanceGroupName>
				<dcscom:balanceType>OpeningBalance</dcscom:balanceType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоШтПриход</dataPath>
			<field>КоличествоШтПриход</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоШтРасход</dataPath>
			<field>КоличествоШтРасход</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъемКонечныйОстаток</dataPath>
			<field>ОбъемКонечныйОстаток</field>
			<role>
				<dcscom:balance>true</dcscom:balance>
				<dcscom:balanceGroupName>Объем</dcscom:balanceGroupName>
				<dcscom:balanceType>ClosingBalance</dcscom:balanceType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъемНачальныйОстаток</dataPath>
			<field>ОбъемНачальныйОстаток</field>
			<role>
				<dcscom:balance>true</dcscom:balance>
				<dcscom:balanceGroupName>Объем</dcscom:balanceGroupName>
				<dcscom:balanceType>OpeningBalance</dcscom:balanceType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъемПриход</dataPath>
			<field>ОбъемПриход</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбъемРасход</dataPath>
			<field>ОбъемРасход</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ДвижениеПоПроизводствуОстаткиИОбороты.ВидДвиженияПроизводство,
	ДвижениеПоПроизводствуОстаткиИОбороты.Номенклатура,
	ДвижениеПоПроизводствуОстаткиИОбороты.ХарактеристикаНоменклатуры,
	ДвижениеПоПроизводствуОстаткиИОбороты.Пакет_Штабель,
	ДвижениеПоПроизводствуОстаткиИОбороты.КоличествоШтКонечныйОстаток,
	ДвижениеПоПроизводствуОстаткиИОбороты.КоличествоШтНачальныйОстаток,
	ДвижениеПоПроизводствуОстаткиИОбороты.КоличествоШтПриход,
	ДвижениеПоПроизводствуОстаткиИОбороты.КоличествоШтРасход,
	ДвижениеПоПроизводствуОстаткиИОбороты.ОбъемКонечныйОстаток,
	ДвижениеПоПроизводствуОстаткиИОбороты.ОбъемНачальныйОстаток,
	ДвижениеПоПроизводствуОстаткиИОбороты.ОбъемПриход,
	ДвижениеПоПроизводствуОстаткиИОбороты.ОбъемРасход
ИЗ
	РегистрНакопления.ДвижениеПоПроизводству.ОстаткиИОбороты КАК ДвижениеПоПроизводствуОстаткиИОбороты</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоШтКонечныйОстаток</dataPath>
		<expression>Сумма(КоличествоШтКонечныйОстаток)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоШтНачальныйОстаток</dataPath>
		<expression>Сумма(КоличествоШтНачальныйОстаток)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоШтПриход</dataPath>
		<expression>Сумма(КоличествоШтПриход)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоШтРасход</dataPath>
		<expression>Сумма(КоличествоШтРасход)</expression>
	</totalField>
	<totalField>
		<dataPath>ОбъемКонечныйОстаток</dataPath>
		<expression>Сумма(ОбъемКонечныйОстаток)</expression>
	</totalField>
	<totalField>
		<dataPath>ОбъемНачальныйОстаток</dataPath>
		<expression>Сумма(ОбъемНачальныйОстаток)</expression>
	</totalField>
	<totalField>
		<dataPath>ОбъемПриход</dataPath>
		<expression>Сумма(ОбъемПриход)</expression>
	</totalField>
	<totalField>
		<dataPath>ОбъемРасход</dataPath>
		<expression>Сумма(ОбъемРасход)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>false</useRestriction>
	</parameter>
	<nestedSchema>
		<name>ПакетыНеОформленые</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Пакеты не оформленые</v8:content>
			</v8:item>
		</title>
		<schema>
			<dataSource>
				<name>ИсточникДанных1</name>
				<dataSourceType>Local</dataSourceType>
			</dataSource>
			<dataSet xsi:type="DataSetQuery">
				<name>НаборДанных1</name>
				<field xsi:type="DataSetFieldField">
					<dataPath>Пакет</dataPath>
					<field>Пакет</field>
				</field>
				<dataSource>ИсточникДанных1</dataSource>
				<query>ВЫБРАТЬ
	Пакеты.Ссылка КАК Пакет,
	ЕСТЬNULL(СостояниеПакетаСрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияПакетов.НеОприходован)) КАК Состояние
ПОМЕСТИТЬ ВР_Пакеты
ИЗ
	Справочник.Пакеты КАК Пакеты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПакета.СрезПоследних КАК СостояниеПакетаСрезПоследних
		ПО СостояниеПакетаСрезПоследних.Пакет = Пакеты.Ссылка
ГДЕ
	НЕ Пакеты.ПометкаУдаления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВР_Пакеты.Пакет
ИЗ
	ВР_Пакеты КАК ВР_Пакеты
ГДЕ
	ВР_Пакеты.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияПакетов.НеОприходован)</query>
			</dataSet>
			<parameter>
				<name>Период</name>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Период</v8:content>
					</v8:item>
				</title>
				<valueType>
					<v8:Type>xs:dateTime</v8:Type>
					<v8:DateQualifiers>
						<v8:DateFractions>DateTime</v8:DateFractions>
					</v8:DateQualifiers>
				</valueType>
				<useRestriction>false</useRestriction>
			</parameter>
			<settingsVariant>
				<dcsset:name>Основной</dcsset:name>
				<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
				<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
					<dcsset:selection>
