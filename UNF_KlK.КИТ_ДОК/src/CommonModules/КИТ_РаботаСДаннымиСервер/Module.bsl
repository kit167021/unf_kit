

Функция ПолучениеХарактерстикиКруглогоЛесоматериала(ЗначениеДиаметр,ЗначениеПорода,ЧислоДлина,Номенклатура) Экспорт
	
	ЗначениеДлина = ПолучитьЗначениеХарактеристикиДлина(ЧислоДлина);
	
	ХарактеристикаПоиска = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК ХарактеристикаПоиска,
		|	1 КАК КоличествоВхождений
		|ПОМЕСТИТЬ ВР_Выборка
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
		|ГДЕ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение = &ЗначениеПорода
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &СвойствоПорода
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК ХарактеристикаПоиска,
		|	1
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
		|ГДЕ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение = &ЗначениеДиаметр
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &СвойствоДиаметр
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК ХарактеристикаПоиска,
		|	1
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
		|ГДЕ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение = &ЗначениеДлина
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &СвойствоДлина
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец = &Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВР_Выборка.ХарактеристикаПоиска,
		|	СУММА(ВР_Выборка.КоличествоВхождений) КАК КоличествоВхождений
		|ПОМЕСТИТЬ ВР_Группировка
		|ИЗ
		|	ВР_Выборка КАК ВР_Выборка
		|СГРУППИРОВАТЬ ПО
		|	ВР_Выборка.ХарактеристикаПоиска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВР_Группировка.ХарактеристикаПоиска
		|ИЗ
		|	ВР_Группировка КАК ВР_Группировка
		|ГДЕ
		|	ВР_Группировка.КоличествоВхождений = 3";
	
	Запрос.УстановитьПараметр("СвойствоДлина", ЗначениеДлина.Владелец);
	Запрос.УстановитьПараметр("СвойствоДиаметр", Константы.СвойствоДляДиаметра.Получить());
	Запрос.УстановитьПараметр("ЗначениеДлина", ЗначениеДлина);
	Запрос.УстановитьПараметр("ЗначениеДиаметр", ЗначениеДиаметр);
	Запрос.УстановитьПараметр("ЗначениеПорода", ЗначениеПорода);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СвойствоПорода", Константы.СвойствоДляПород.Получить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Характеристикапоиска = ВыборкаДетальныеЗаписи.ХарактеристикаПоиска;	
	КонецЦикла;
	
	Если не ЗначениеЗаполнено(Характеристикапоиска) Тогда
		ХарактеристикаНовая = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		ХарактеристикаНовая.Владелец = Номенклатура;
		
		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Константы.СвойствоДляДиаметра.Получить();
		СтрокаДопРеквизит.Значение = ЗначениеДиаметр;
		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Константы.СвойствоДляПород.Получить();
		СтрокаДопРеквизит.Значение = ЗначениеПорода;
		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = ЗначениеДлина.Владелец;
		СтрокаДопРеквизит.Значение = ЗначениеДлина;	
		
		ХарактеристикаНовая.Наименование = ""+ЗначениеДиаметр +", "+ЗначениеПорода +", "+ЗначениеДлина;
		ХарактеристикаНовая.НаименованиеДляПечати = ""+ЗначениеДиаметр +", "+ЗначениеПорода +", "+ЗначениеДлина;		
		//ШаблоныНаименований.СформироватьНаименования(ХарактеристикаНовая, Истина);
		
		ХарактеристикаНовая.Записать();
		Характеристикапоиска = ХарактеристикаНовая.Ссылка;
	КонецЕсли;
	
	Возврат Характеристикапоиска;	
Конецфункции

Функция ПолучениеХарактерстикиПиломатериалов(Порода,Толщина,Ширина,Сорт,Длина,Влажность,Номенклатура,Отказ) Экспорт
	ХарактеристикаПоиска = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	Сечение = НайтиСечение(Толщина,Ширина);
	Если Не ЗначениеЗаполнено(Сечение) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Не найдено значение сечения для "+Толщина+"мм и "+Ширина+"мм");
		Возврат ХарактеристикаПоиска;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК ХарактеристикаПоиска,
		|	1 КАК КоличествоВхождений
		|ПОМЕСТИТЬ ВР_Выборка
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
		|ГДЕ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение = &ЗначениеПорода
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &СвойствоПорода
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК ХарактеристикаПоиска,
		|	1
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
		|ГДЕ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение = &ЗначениеСорт
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &СвойствоСорт
		|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК ХарактеристикаПоиска,
		|	1
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
		|ГДЕ
		|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение = &ЗначениеСечение
