	Запрос.УстановитьПараметр("СвойствоДлина", Длина.ДлинаХарактеристика.Владелец);
	Запрос.УстановитьПараметр("ЗначениеДлина", Длина.ДлинаХарактеристика);

	

	Запрос.УстановитьПараметр("СвойствоВлажность", Влажность.Владелец);
	Запрос.УстановитьПараметр("ЗначениеВлажность", Влажность);

	Запрос.УстановитьПараметр("СвойствоСечение", Сечение.Владелец);
	Запрос.УстановитьПараметр("ЗначениеСечение", Сечение);
	
	Запрос.УстановитьПараметр("СвойствоСорт", Сорт.Владелец);
	Запрос.УстановитьПараметр("ЗначениеСорт", Сорт);

	Запрос.УстановитьПараметр("СвойствоПорода", Порода.Владелец);
	Запрос.УстановитьПараметр("ЗначениеПорода", Порода);
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Характеристикапоиска = ВыборкаДетальныеЗаписи.ХарактеристикаПоиска;	
	КонецЦикла;
	
	Если не ЗначениеЗаполнено(Характеристикапоиска) Тогда
		ХарактеристикаНовая = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		ХарактеристикаНовая.Владелец = Номенклатура;
		
		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Порода.Владелец;
		СтрокаДопРеквизит.Значение = Порода;
		
		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Сорт.Владелец;
		СтрокаДопРеквизит.Значение = Сорт;

		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Сечение.Владелец;
		СтрокаДопРеквизит.Значение = Сечение;

		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Влажность.Владелец;
		СтрокаДопРеквизит.Значение = Влажность;
	
		СтрокаДопРеквизит = ХарактеристикаНовая.ДополнительныеРеквизиты.Добавить();
		СтрокаДопРеквизит.Свойство = Длина.ДлинаХарактеристика.Владелец;
		СтрокаДопРеквизит.Значение = Длина.ДлинаХарактеристика;
		
		ХарактеристикаНовая.Наименование = ""+Порода +", "+Сорт +", "+Сечение+", "+Длина+", "+Влажность;
		ХарактеристикаНовая.НаименованиеДляПечати = ""+Порода +", "+Сорт +", "+Сечение+", "+Длина+", "+Влажность;		
		//ШаблоныНаименований.СформироватьНаименования(ХарактеристикаНовая, Истина);
		
		ХарактеристикаНовая.Записать();
		Характеристикапоиска = ХарактеристикаНовая.Ссылка;
	КонецЕсли;
	
	Возврат Характеристикапоиска;	
Конецфункции

Функция ПолучитьЗначениеХарактеристикиДлина(ЧислоДлина)

	ДлинаХарактеристика = Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Длины.ДлинаХарактеристика
		|ИЗ
		|	Справочник.Длины КАК Длины
		|ГДЕ
		|	Длины.Длина = &ЧислоДлина
		|	И Длины.ВидРеквизита = &ВидРеквизита";
	
	Запрос.УстановитьПараметр("ВидРеквизита", Перечисления.ВидыРеквизита.ПФ);
	Запрос.УстановитьПараметр("ЧислоДлина", ЧислоДлина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДлинаХарактеристика = ВыборкаДетальныеЗаписи.ДлинаХарактеристика;	
	КонецЦикла;
	
	Возврат ДлинаХарактеристика;

КонецФункции

Функция ОбъемВычислить(КоличествоДосок, Толщина, Ширина, Длина)  Экспорт   
	Объем = 0;	
	Попытка  
		Объем = Окр(КоличествоДосок * Толщина.Толщина * Ширина.Ширина * Длина.Длина / 1000000, 2);
	Исключение		
	КонецПопытки;
	
	Возврат(Объем);
	
КонецФункции

Функция НайтиСечение(Толщина,Ширина) Экспорт
	
	Сечение = Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоотвествиеСечений.Сечение КАК Сечение
		|ИЗ
		|	РегистрСведений.СоотвествиеСечений КАК СоотвествиеСечений
		|ГДЕ
		|	СоотвествиеСечений.Толщина = &Толщина
		|	И СоотвествиеСечений.Ширина = &Ширина";

	Запрос.УстановитьПараметр("Толщина", Толщина);
	Запрос.УстановитьПараметр("Ширина", Ширина);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сечение = ВыборкаДетальныеЗаписи.Сечение;
	КонецЦикла;

	Возврат Сечение;

КонецФункции

//Поиск серии и создание. Связка Номенклатура + Характеристика + Серия
Функция НайтиСериюНоменклатуры(КодСерии,НоменклатураСерии) Экспорт
	СерияПакета = Справочники.СерииНоменклатуры.ПустаяСсылка();
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СерииНоменклатуры.Ссылка КАК СЕРИЯ
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
		|ГДЕ
		|	СерииНоменклатуры.Наименование = &СерийныйНомер
		|	И СерииНоменклатуры.Владелец = &Владелец";

	Запрос.УстановитьПараметр("СерийныйНомер", КодСерии);
	Запрос.УстановитьПараметр("Владелец", НоменклатураСерии);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СерияПакета = ВыборкаДетальныеЗаписи.СЕРИЯ;		
	КонецЦикла;

	Если Не ЗначениеЗаполнено(СерияПакета) Тогда
		
		СерияПакетОбъект = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		СерияПакетОбъект.Владелец = НоменклатураСерии;
		СерияПакетОбъект.Наименование = КодСерии;
		СерияПакетОбъект.Записать();
		СерияПакета = СерияПакетОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат СерияПакета;
	
КонецФункции

Функция ДанныеПакета(Пакет) Экспорт
	
	СтруктураПакета = Новый Структура("Стандарт,КоличествоДосок,Номенклатура,ХарактеристикаНоменклатуры,Влажность,Длина,Ширина,Толщина,Объем");
	СтруктураПакета.Стандарт = Пакет.Стандарт;
	СтруктураПакета.КоличествоДосок = Пакет.КоличествоДосок;
	СтруктураПакета.Номенклатура = Пакет.Номенклатура;
	СтруктураПакета.ХарактеристикаНоменклатуры = Пакет.ХарактеристикаНоменклатуры;
	СтруктураПакета.Влажность = Пакет.Влажность;
	СтруктураПакета.Длина = Пакет.Длина;
	СтруктураПакета.Ширина =  Пакет.Ширина;
	СтруктураПакета.Толщина = Пакет.Толщина;
	СтруктураПакета.Объем = Пакет.Объем;
	
	Возврат СтруктураПакета;
	
КонецФункции