&НаКлиенте
Процедура РассчитатьКоличествоПачки()
	СтрПачек = Элементы.ДанныеПачек.ТекущиеДанные;
	Если СтрПачек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    СтрПачек.Количество = СтрПачек.ДлинаПачки*СтрПачек.ШиринаПачки*СтрПачек.ВысотаПачки*СтрПачек.КоэффицентДревесности;
	
КонецПроцедуры

&НаСервере
Функция НайтиДиапозонДиаметр(Диаметр)
	ДимаетрДиапозонПоиска = Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка(); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Диаметры.ДиаметрХарактеристика КАК ДиаметрХарактеристика
		|ИЗ
		|	Справочник.Диаметр КАК Диаметры
		|ГДЕ
		|	Диаметры.Диаметр = &Диаметр";
	
	Запрос.УстановитьПараметр("Диаметр", Диаметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДимаетрДиапозонПоиска = ВыборкаДетальныеЗаписи.ДиаметрХарактеристика; 
	КонецЦикла;
	
	Возврат ДимаетрДиапозонПоиска;
	
КонецФункции	

&НаКлиенте
Процедура Заполнить(Команда)
	Для счетчик = ДиаметрНачальный по ДиаметрКонечный Цикл
		Если (Счетчик/2-Окр(Счетчик/2))<> 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрЗамеры = Объект.ЗамерыРучнойУчет.Добавить();
		СтрЗамеры.Номенклатура = Номенклатура; 
		//СтрЗамеры.НоменклатураБрак = Брак;
        СтрЗамеры.Диаметр = НайтиДиапозонДиаметр(счетчик);
		СтрЗамеры.Порода = Порода;
		СтрЗамеры.ДиаметрЧисло = счетчик;
		СтрЗамеры.Длина  = Длина;
		СтрЗамеры.Штабель  = Штабель;
	КонецЦикла;

КонецПроцедуры


#КонецОбласти


#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Ключ.Пустая() Тогда
		
	КонецЕсли; 
	
	ПВХ_Диаметры = константы.СвойствоДляДиаметра.Получить(); 
	ПВХ_Породы = Константы.СвойствоДляПород.Получить(); 
	
    Длина = 4.0;
	СформироватьТаблицуДиаметров(); 
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ПечатьДокументовУНФ.УстановитьОтображениеПодменюПечати(Элементы.ПодменюПечать);

КонецПроцедуры


