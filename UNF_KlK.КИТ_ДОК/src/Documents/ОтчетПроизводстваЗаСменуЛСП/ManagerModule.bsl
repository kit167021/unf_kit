Процедура ПечатьРеестр(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(Печать)
	Макет = Документы.ОтчетПроизводстваЗаСменуЛСП.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОтчетПроизводстваЗаСменуЛСП.Номер КАК Номер,
		|	ОтчетПроизводстваЗаСменуЛСП.Дата КАК Дата,
		|	ОтчетПроизводстваЗаСменуЛСП.ДатаНачала КАК ДатаНачала,
		|	ОтчетПроизводстваЗаСменуЛСП.ДатаОкончания КАК ДатаОкончания,
		|	ОтчетПроизводстваЗаСменуЛСП.СкладПолучатель КАК СкладПолучатель,
		|	ОтчетПроизводстваЗаСменуЛСП.Смена КАК Смена,
		|	ОтчетПроизводстваЗаСменуЛСП.Выпуск.(
		|		НомерСтроки КАК НомерСтроки,
		|		Пакет КАК Пакет,
		|		Стандарт КАК Стандарт,
		|		Толщина КАК Толщина,
		|		Ширина КАК Ширина,
		|		Длина КАК Длина,
		|		Влажность КАК Влажность,
		|		КоличествоДосок КАК КоличествоДосок,
		|		Объем КАК Объем
		|	) КАК Выпуск,
		|	ОтчетПроизводстваЗаСменуЛСП.ВозвратныеОтходы.(
		|		НомерСтроки КАК НомерСтроки,
		|		Номенклатура КАК Номенклатура,
		|		ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|		Количество КАК Количество,
		|		Цена КАК Цена,
		|		Сумма КАК Сумма
		|	) КАК ВозвратныеОтходы,
		|	ОтчетПроизводстваЗаСменуЛСП.Сырье.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Номенклатура КАК Номенклатура,
		|		Порода КАК Порода,
		|		Сорт КАК Сорт,
		|		Длина КАК Длина,
		|		Ширина КАК Ширина,
		|		Толщина КАК Толщина,
		|		КоличествоДосок КАК КоличествоДосок,
		|		ОбъемДосок КАК ОбъемДосок,
		|		СкладОтправитель КАК СкладОтправитель,
		|		Несертифицированный КАК Несертифицированный
		|	) КАК Сырье
		|ИЗ
		|	Документ.ОтчетПроизводстваЗаСменуЛСП КАК ОтчетПроизводстваЗаСменуЛСП
		|ГДЕ
		|	ОтчетПроизводстваЗаСменуЛСП.Ссылка В(&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьВыпускШапка = Макет.ПолучитьОбласть("ВыпускШапка");
	ОбластьВыпуск = Макет.ПолучитьОбласть("Выпуск");
	ОбластьВозвратныеОтходыШапка = Макет.ПолучитьОбласть("ВозвратныеОтходыШапка");
	ОбластьВозвратныеОтходы = Макет.ПолучитьОбласть("ВозвратныеОтходы");
	ОбластьСырьеШапка = Макет.ПолучитьОбласть("СырьеШапка");
	ОбластьСырье = Макет.ПолучитьОбласть("Сырье");

	Пока Выборка.Следующий() Цикл
		
		ТабДок.Вывести(ОбластьЗаголовок);
		
		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());	
		ТабДок.Вывести(ОбластьВыпускШапка);
		ВыборкаВыпуск = Выборка.Выпуск.Выбрать();
		Пока ВыборкаВыпуск.Следующий() Цикл
			ОбластьВыпуск.Параметры.Заполнить(ВыборкаВыпуск);
			ТабДок.Вывести(ОбластьВыпуск, ВыборкаВыпуск.Уровень());
		КонецЦикла;		ТабДок.Вывести(ОбластьВозвратныеОтходыШапка);
		ВыборкаВозвратныеОтходы = Выборка.ВозвратныеОтходы.Выбрать();
		Пока ВыборкаВозвратныеОтходы.Следующий() Цикл
			ОбластьВозвратныеОтходы.Параметры.Заполнить(ВыборкаВозвратныеОтходы);
			ТабДок.Вывести(ОбластьВозвратныеОтходы, ВыборкаВозвратныеОтходы.Уровень());
		КонецЦикла; 
		
		ТабДок.Вывести(ОбластьСырьеШапка);
		ВыборкаСырье = Выборка.Сырье.Выбрать();
		Пока ВыборкаСырье.Следующий() Цикл
			ОбластьСырье.Параметры.Заполнить(ВыборкаСырье);
			ТабДок.Вывести(ОбластьСырье, ВыборкаСырье.Уровень());
		КонецЦикла;

		
	КонецЦикла;
	//}}
КонецПроцедуры

