&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СостояниеПакетаСрезПоследних.Состояние, ЗНАЧЕНИЕ(перечисление.СостоянияПакетов.НеОприходован)) КАК
		|		СостояниеПакета,
		|	СправочникПакеты.Ссылка КАК Пакет
		|ИЗ
		|	Справочник.Пакеты КАК СправочникПакеты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПакета.СрезПоследних(&Дата,) КАК СостояниеПакетаСрезПоследних
		|		ПО СправочникПакеты.Ссылка = СостояниеПакетаСрезПоследних.Пакет
		|ГДЕ
		|	ЕСТЬNULL(СостояниеПакетаСрезПоследних.Состояние,
		|		ЗНАЧЕНИЕ(перечисление.СостоянияПакетов.НеОприходован)) = ЗНАЧЕНИЕ(перечисление.СостоянияПакетов.НеОприходован)
		|	И СправочникПакеты.ДатаПакета МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СправочникПакеты.Смена = &Смена";
	
	Запрос.УстановитьПараметр("ДатаОкончания", Объект.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Смена", Объект.Смена);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТаб = Объект.Выпуск.Добавить();
		СтрокаТаб.Пакет = ВыборкаДетальныеЗаписи.Пакет;
		СтруктураДанныхПакета = КИТ_РаботаСДаннымиСервер.ДанныеПакета(СтрокаТаб.Пакет);
		ЗаполнитьЗначенияСвойств(СтрокаТаб, СтруктураДанныхПакета);

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
